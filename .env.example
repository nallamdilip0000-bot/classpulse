# ====================================================================
# ClassPulse Environment Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. MongoDB Atlas Cloud Database Configuration (Recommended)
# --------------------------------------------------------------------
# Obtain your connection string from MongoDB Atlas:
# 1. Sign in at https://cloud.mongodb.com
# 2. Click "Connect" on your Cluster -> Choose "Drivers" (Node.js)
# 3. Copy the URI and replace <username> and <password> with your database user credentials.
#
# Syntax breakdown:
# mongodb+srv://<username>:<password>@<cluster-domain>/<dbname>?retryWrites=true&w=majority
#
# Concrete example:
# MONGODB_URI=mongodb+srv://classpulse_admin:MySecurePass2026@cluster0.abcde.mongodb.net/classpulse?retryWrites=true&w=majority
#
# NOTE: If your password contains special characters (like @, #, $, %, &),
# URL-encode them (e.g. '@' -> '%40', '#' -> '%23').

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/classpulse?retryWrites=true&w=majority

# Backend Server Port (Default: 5000)
PORT=5000

# Frontend API base URL (connects Vite frontend to Express backend)
VITE_API_URL=http://localhost:5000/api

# --------------------------------------------------------------------
# 2. Optional: Supabase Cloud Configuration
# --------------------------------------------------------------------
# If using Supabase instead of MongoDB:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --------------------------------------------------------------------
# 3. Demo Mode (Fallback)
# --------------------------------------------------------------------
# If neither MONGODB_URI nor Supabase is configured, ClassPulse runs
# in Zero-Configuration Demo Mode with browser-local persistence.
