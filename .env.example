# ====================================================================
# ClassPulse Environment Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. MongoDB Atlas Database Configuration (Recommended)
# --------------------------------------------------------------------
# Replace with your MongoDB Atlas connection string from https://cloud.mongodb.com:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/classpulse?retryWrites=true&w=majority

# Backend Server Port (Default: 5000)
PORT=5000

# Frontend API base URL (connects Vite frontend to Express backend)
VITE_API_URL=http://localhost:5000/api

# --------------------------------------------------------------------
# 2. Optional: Supabase Cloud Configuration
# --------------------------------------------------------------------
# If using Supabase instead of MongoDB:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --------------------------------------------------------------------
# 3. Demo Mode (Fallback)
# --------------------------------------------------------------------
# If neither MONGODB_URI nor Supabase is configured, ClassPulse runs
# in Zero-Configuration Demo Mode with browser-local persistence.
